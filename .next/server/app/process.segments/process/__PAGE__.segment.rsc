17:["$","section",null,{"className":"section","children":["$","div",null,{"className":"container-x max-w-4xl","children":[["$","$Lf",null,{"className":"mb-10 flex flex-col gap-6 lg:mb-14 items-center text-center","children":[["$","div",null,{"className":"max-w-2xl mx-auto","children":[["$","span",null,{"className":"eyebrow mb-4","children":"FAQs"}],["$","h2",null,{"className":"text-[2rem] leading-[1.12] sm:text-4xl lg:text-[2.9rem] text-forest","children":["$","$L13",null,{"text":"Frequently Asked Questions"}]}],"$undefined"]}],"$undefined"]}],["$","$L2a",null,{"items":[{"q":"Which cities do you serve?","a":"We take up projects across all of Andhra Pradesh and in Hyderabad — including Vijayawada, Visakhapatnam, Guntur, Tirupati, Nellore, Kadapa, Kurnool, Anantapur and Nandyal, as well as smaller towns. Tell us where your home is and we'll plan a site visit."},{"q":"Is the site visit and quotation free?","a":"Yes, site visits and quotations are free within our service locations. Any conditions will be explained when you book."},{"q":"What is the free 3D design?","a":"We prepare a 3D design of your space so you can see the proposed interiors before work begins. You decide whether to proceed after reviewing it. Scope and conditions are confirmed during consultation."},{"q":"Do you handle single rooms or only complete homes?","a":"Both. We take up individual projects such as a modular kitchen, wardrobes or a TV unit, as well as complete home interiors."},{"q":"How long does a project take?","a":"Timelines depend on scope, materials and site readiness. We share a schedule along with your quotation."},{"q":"Can I choose the materials and brands?","a":"Yes. Material options, finishes and hardware are discussed and finalised with you during material selection."}]}]]}]}]
